# Logs
*.log

# Compiled files
dist
# Generated TypeDoc output. Kept out of docs/, which holds the hand-written migration guides.
dist-docs

# Intermediate build artifacts (e.g. the pruned Context spec)
.tmp

# Coverage directories used by tools like c8
coverage

# Dependency directories
node_modules

# Deno cache lockfile (created by `npm run test:deno`)
deno.lock

# MacOS
.DS_Store
tsconfig.vitest-temp.json

#Jetbrains
.idea
*.iml

# Deno runtime test fixtures (created by `npm run test:deno`)
runtimes/deno/*.tgz
runtimes/deno/package-lock.json

# Test CA private key - only needed to regenerate test/certs/server, and
# committing it would invite reuse. See test/certs/README.md.
test/certs/ca.key
