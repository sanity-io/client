{
  "name": "@sanity/client",
  "version": "7.26.2",
  "description": "Client for retrieving, creating and patching data from Sanity.io",
  "keywords": [
    "api",
    "client",
    "cms",
    "content",
    "fetch",
    "headless",
    "realtime",
    "sanity"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/client/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/client.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-server": "./dist/index.js",
      "sanity-function": "./dist/index.js",
      "deno": "./dist/index.js",
      "bun": "./dist/index.js",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "node": {
        "source": "./src/index.node.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.js"
      },
      "default": "./dist/index.js"
    },
    "./csm": {
      "source": "./src/csm/index.ts",
      "default": "./dist/csm.js"
    },
    "./stega": {
      "source": "./src/stega/index.ts",
      "default": "./dist/stega.js"
    },
    "./media-library": {
      "source": "./src/media-library.ts",
      "default": "./dist/media-library.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "react-server": "./dist/index.js",
        "sanity-function": "./dist/index.js",
        "deno": "./dist/index.js",
        "bun": "./dist/index.js",
        "workerd": "./dist/index.js",
        "worker": "./dist/index.js",
        "node": {
          "import": "./dist/index.node.js",
          "require": "./dist/index.node.js"
        },
        "default": "./dist/index.js"
      },
      "./csm": "./dist/csm.js",
      "./stega": "./dist/stega.js",
      "./media-library": "./dist/media-library.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg build --strict && pkg --strict",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "test:bun": "bun test runtimes/bun",
    "test:deno": "deno test --allow-read --allow-net --allow-env --fail-fast --node-modules-dir=manual runtimes/deno",
    "test:next": "vitest run --config ./vitest.next.config.ts",
    "test:node-runtimes": "(cd runtimes/node && node --test)",
    "test:vercel-edge": "vitest run --config ./vitest.vercel-edge.config.ts",
    "test:workerd": "vitest run --config ./vitest.workerd.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "eventsource": "^5.0.0",
    "get-it": "^9.4.1",
    "nanoid": "^3.3.17",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@edge-runtime/types": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@sanity/pkg-utils": "^12.1.0",
    "@types/debug": "^4.1.12",
    "@types/json-diff": "^1.0.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vercel/stega": "1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eventsource-encoder": "^1.0.2",
    "happy-dom": "^20.11.1",
    "json-diff": "^1.0.6",
    "ls-engines": "^0.10.1",
    "next": "^16.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pkg-pr-new": "^0.0.86",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.4.1",
  "inlinedDependencies": {
    "@vercel/stega": "1.1.0"
  }
}
