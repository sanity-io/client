{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sanity-io/renovate-config", ":reviewer(team:ecosystem)"],
  "ignorePresets": ["github>sanity-io/renovate-config:min-age-exceptions"],
  "packageRules": [
    {
      "matchPackageNames": ["@sanity/eventsource", "@vercel/stega", "get-it"],
      "rangeStrategy": "bump",
      "semanticCommitType": "fix",
      "groupName": null,
      "groupSlug": null
    },
    {
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "vitest"
    }
  ],
  "bun": {
    "enabled": false
  }
}
